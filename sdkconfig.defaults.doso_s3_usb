# DOSO Robot ESP32-S3 USB-Direct Audio & Robot SFX build defaults
# Usage: idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.doso_s3_usb" set-target esp32s3 build
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_LANGUAGE_ZH_CN=y
CONFIG_BOARD_TYPE_ESP32_S3_BOX_LITE=y
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_WAKE_WORD_DISABLED=y
CONFIG_USE_AFE_WAKE_WORD=n
CONFIG_SEND_WAKE_WORD_DATA=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
